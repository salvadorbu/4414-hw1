Notebook[{
Cell["\<\
Here are both of our defined funnels, where f1 is the 1-Dimensional funnel \
and mullerBrown is our 2-Dimensional folding funnel\
\>", "Text",
 CellChangeTimes->{{3.951832223184021*^9, 
  3.951832253129869*^9}},ExpressionUUID->"4f1eb1ee-f19f-4c87-a6ed-\
a22f25f4c059"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"f1", "[", "x_", "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"x", "-", "2"}], ")"}], "^", "2"}], "+", 
   RowBox[{"0.5", " ", 
    RowBox[{"Sin", "[", 
     RowBox[{"10", " ", "x"}], "]"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"mullerBrown", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "200"}], "*", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "1"}], "*", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"x", "-", "1"}], ")"}], "^", "2"}]}], "-", 
        RowBox[{"10", "*", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"y", "-", "0"}], ")"}], "^", "2"}]}]}], "]"}]}], "+", 
     RowBox[{
      RowBox[{"-", "100"}], "*", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "1"}], "*", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"x", "-", "0"}], ")"}], "^", "2"}]}], "-", 
        RowBox[{"10", "*", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"y", "-", "0.5"}], ")"}], "^", "2"}]}]}], "]"}]}], "+", 
     RowBox[{
      RowBox[{"-", "170"}], "*", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "6.5"}], "*", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"x", "+", "0.5"}], ")"}], "^", "2"}]}], "+", 
        RowBox[{"11", "*", 
         RowBox[{"(", 
          RowBox[{"x", "+", "0.5"}], ")"}], "*", 
         RowBox[{"(", 
          RowBox[{"y", "-", "1.5"}], ")"}]}], "-", 
        RowBox[{"6.5", "*", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"y", "-", "1.5"}], ")"}], "^", "2"}]}]}], "]"}]}], "+", 
     RowBox[{"15", "*", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"0.7", "*", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"x", "+", "1"}], ")"}], "^", "2"}]}], "+", 
        RowBox[{"0.6", "*", 
         RowBox[{"(", 
          RowBox[{"x", "+", "1"}], ")"}], "*", 
         RowBox[{"(", 
          RowBox[{"y", "-", "1"}], ")"}]}], "+", 
        RowBox[{"0.7", "*", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"y", "-", "1"}], ")"}], "^", "2"}]}]}], "]"}]}]}]}], ";"}],
   "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"f1", "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "2"}], ",", "6"}], "}"}], ",", 
   RowBox[{
   "PlotLabel", "->", 
    "\"\<1D Folding Funnel with Multiple Local Minima\>\""}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Coordinate\>\"", ",", "\"\<Energy\>\""}], "}"}]}], ",", 
   RowBox[{"PlotStyle", "->", "Thick"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ContourPlot", "[", 
   RowBox[{
    RowBox[{"mullerBrown", "[", 
     RowBox[{"x", ",", "y"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"-", "1.5"}], ",", "1.5"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"y", ",", 
      RowBox[{"-", "0.5"}], ",", "2.0"}], "}"}], ",", 
    RowBox[{"PlotRange", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "150"}], ",", "100"}], "}"}]}], ",", 
    RowBox[{"Contours", "->", "30"}], ",", 
    RowBox[{"ContourLines", "->", "True"}], ",", 
    RowBox[{"ColorFunction", "->", "\"\<ThermometerColors\>\""}], ",", 
    RowBox[{"PlotLegends", "->", "Automatic"}], ",", 
    RowBox[{"FrameLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}], ",", 
    RowBox[{
    "PlotLabel", "->", 
     "\"\<M\[UDoubleDot]ller-Brown Potential Energy Surface\>\""}], ",", 
    RowBox[{"ImageSize", "->", "Large"}], ",", 
    RowBox[{"PlotPoints", "->", "100"}]}], "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot3D", "[", 
  RowBox[{
   RowBox[{"mullerBrown", "[", 
    RowBox[{"x", ",", "y"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "1.5"}], ",", "1.5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", 
     RowBox[{"-", "0.5"}], ",", "2.0"}], "}"}], ",", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "150"}], ",", "100"}], "}"}]}], ",", 
   RowBox[{"ColorFunction", "->", "\"\<ThermometerColors\>\""}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<x\>\"", ",", "\"\<y\>\"", ",", "\"\<Energy\>\""}], "}"}]}], 
   ",", 
   RowBox[{
   "PlotLabel", "->", 
    "\"\<M\[UDoubleDot]ller-Brown Potential Energy Surface\>\""}], ",", 
   RowBox[{"ViewPoint", "->", 
    RowBox[{"{", 
     RowBox[{"1.3", ",", 
      RowBox[{"-", "2.4"}], ",", "2.0"}], "}"}]}], ",", 
   RowBox[{"ImageSize", "->", "Large"}], ",", 
   RowBox[{"PlotPoints", "->", "100"}], ",", 
   RowBox[{"MaxRecursion", "->", "4"}], ",", 
   RowBox[{"MeshFunctions", "->", 
    RowBox[{"{", 
     RowBox[{"#3", "&"}], "}"}]}], ",", 
   RowBox[{"Mesh", "->", "15"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Find", " ", "the", " ", "global", " ", "minimum", " ", "to", " ", 
    "verify", " ", "minimization", " ", "methods"}], "*)"}], 
  RowBox[{"globalMin", "=", 
   RowBox[{"NMinimize", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"mullerBrown", "[", 
        RowBox[{"x", ",", "y"}], "]"}], ",", 
       RowBox[{
        RowBox[{"-", "1.5"}], "<=", "x", "<=", "1.5"}], ",", 
       RowBox[{
        RowBox[{"-", "0.5"}], "<=", "y", "<=", "2.0"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Global minimum value: \>\"", ",", 
   RowBox[{"globalMin", "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "\n", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Position of global minimum: {x = \>\"", ",", 
   RowBox[{"globalMin", "[", 
    RowBox[{"[", 
     RowBox[{"2", ",", "1", ",", "2"}], "]"}], "]"}], ",", "\"\<, y = \>\"", 
   ",", 
   RowBox[{"globalMin", "[", 
    RowBox[{"[", 
     RowBox[{"2", ",", "2", ",", "2"}], "]"}], "]"}], ",", "\"\<}\>\""}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.951832006090396*^9, 3.951832040436755*^9}, 
   3.951832475179253*^9, {3.9518405752885933`*^9, 3.951840575755343*^9}, {
   3.95184184650951*^9, 3.951841847022606*^9}, 3.951844453516571*^9},
 CellLabel->
  "In[123]:=",ExpressionUUID->"2f0ac864-5db1-4bc2-8964-e24fcd4727c0"],

